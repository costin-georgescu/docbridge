{
  "name": "docbridge",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "dev": "docker compose up",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v",
    "db:generate": "pnpm -r --filter \"./packages/db-*\" run generate",
    "db:migrate": "node --env-file=.env scripts/db.mjs migrate:deploy",
    "db:migrate:dev": "node --env-file=.env scripts/db.mjs migrate:dev",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "e2e": "pnpm --filter @docbridge/e2e test",
    "e2e:install": "pnpm --filter @docbridge/e2e install-browsers",
    "auth:keygen": "node scripts/gen-signing-key.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@types/node": "24.19.2",
    "argon2": "0.45.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "9.1.2",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "dependencies": {
    "@docbridge/db-auth": "workspace:*",
    "@docbridge/db-platform": "workspace:*"
  }
}
