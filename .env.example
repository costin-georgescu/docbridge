# Shared defaults for all local services (copied into every container).
NODE_ENV=development
LOG_LEVEL=debug
AWS_REGION=eu-central-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
STAGING_BUCKET=docbridge-staging
PLATFORM_BUCKET=docbridge-platform
TASKS_QUEUE_URL=http://localstack:4566/000000000000/docbridge-tasks
UPLOAD_EVENTS_QUEUE_URL=http://localstack:4566/000000000000/docbridge-upload-events
WEB_ORIGIN=http://localhost:5173
# PORT and DATABASE_URL are set per service in docker-compose.yml:
#   api        PORT=3000  postgresql://docbridge_app:docbridge_app@postgres:5432/docbridge
#              also gets AUTH_INTERNAL_URL=http://auth:3001,
#              PLATFORM_INTERNAL_URL=http://platform:3002 and
#              S3_PRESIGN_ENDPOINT_URL=http://localhost:4566
#   auth       PORT=3001  postgresql://auth_app:auth_app@postgres:5432/auth
#   platform   PORT=3002  postgresql://platform_app:platform_app@postgres:5432/platform
#              also gets AUTH_INTERNAL_URL=http://auth:3001
#   dispatcher postgresql://docbridge_app:docbridge_app@postgres:5432/docbridge
#   worker     postgresql://docbridge_app:docbridge_app@postgres:5432/docbridge
#              also gets AUTH_INTERNAL_URL=http://auth:3001 and
#              PLATFORM_INTERNAL_URL=http://platform:3002

# Host-side URLs for prisma migrate/seed (containers use DATABASE_URL instead).
AUTH_DATABASE_URL=postgresql://auth_app:auth_app@localhost:5432/auth
DOCBRIDGE_DATABASE_URL=postgresql://docbridge_app:docbridge_app@localhost:5432/docbridge
PLATFORM_DATABASE_URL=postgresql://platform_app:platform_app@localhost:5432/platform
# Local stand-in for the worker service secret (the real one lives in Secrets Manager).
WORKER_CLIENT_SECRET=local-worker-secret

# Rate limits (TDD 5.5). 0 disables; production defaults apply when unset.
# docker-compose disables the api/tree limits because the k6 perf fixtures
# run through them from a single user/IP.
# RATE_LIMIT_JOBS_PER_MIN=30           # api: POST /api/jobs per user
# RATE_LIMIT_UPLOADS_PER_MIN=120       # api: POST /api/uploads* per user
# RATE_LIMIT_SESSION_PER_MIN=60        # auth: refresh+logout per IP
# RATE_LIMIT_SERVICE_TOKEN_PER_MIN=20  # auth: service-token per IP
# RATE_LIMIT_TREE_PER_MIN=60           # platform: GET /tree per IP

# JWT signing key for the auth service (RS256). Optional in development —
# when unset the service generates an ephemeral keypair on boot and logs a
# warning. Required in production. To persist a local key:
#   pnpm auth:keygen >> .env
# JWT_SIGNING_KEY='{"kid":"k-<yyyymmdd>-<hex>","privateKey":"-----BEGIN PRIVATE KEY-----\n..."}'
