// DocBridge — Flow 2a: File submission
// User-facing path: staging, mapping and the submission ack. Ends at 202.
// Background dispatch and delivery continue in flow-2b.
// Dashed self-arrows are local steps, not network calls

title Flow 2a: File submission

webUI [icon: monitor, label: "Web UI"]
api [icon: docker, label: "DocBridge API"]
staging [icon: aws-simple-storage-service, label: "Staging"]
uploadEvents [icon: aws-simple-queue-service, label: "Upload events"]
dispatcher [icon: docker, label: "Dispatcher"]
docbridgeDB [icon: aws-rds, label: "DocBridge DB"]
platform [icon: docker, label: "Document platform"]

// Staging — bytes never touch the API (ADR-08)
loop [label: "per selected file (up to 100)"] {
  webUI > api: "request upload (name, type, size, checksum; rejects non-allowlisted types)"
  api > docbridgeDB: "staged file record (pending upload)"
  api --> api: "mint presigned PUT (content type + checksum bound)"
  api > webUI: "presigned URL"
  webUI > staging: "file bytes (multipart above threshold)"
  alt [label: "multipart upload"] {
    webUI > api: "complete upload (part etags)"
    api > staging: "CompleteMultipartUpload (checksum bound)"
  }
  staging --> staging: "validate checksum on upload"
  // Storage tells us the file landed, not the browser (ADR-13)
  staging > uploadEvents: "object created event"
  uploadEvents > dispatcher: "file staged"
  dispatcher > docbridgeDB: "staged file record -> staged"
}

// Mapping overlaps uploads; Submit unlocks when the API reports all files staged (ADR-09, ADR-13)
webUI --> webUI: "user maps files to destination folders"
loop [label: "poll until all files staged"] {
  webUI > api: "GET staged-file status"
  api > docbridgeDB: "staged file records"
  api > webUI: "per-file staged / pending"
}

// Submission — one platform call + one transaction, then ack (ADR-10)
webUI > api: "submit job (file ids, folder ids, mapping)"
// server-to-server on the internal service name — never routed (ADR-14)
api > platform: "which team owns each destination folder?"
platform > api: "folder -> team"
alt [label: "any folder outside caller's team claims", color: red] {
  api > webUI: "403 rejected, nothing committed"
}
else [label: "all folders authorized"] {
  api > docbridgeDB: "BEGIN: verify all files staged; job (submitter id + team ids) + all task records (pending)"
  alt [label: "any referenced file not staged", color: red] {
    docbridgeDB > api: "ROLLBACK"
    api > webUI: "409 file not staged, nothing committed"
  }
  else [label: "all files staged"] {
    docbridgeDB > api: "COMMIT"
    api > webUI: "202 job accepted (< 500 ms p99)"
  }
}

// Expected outcome: instant confirmation. Dispatch and delivery continue in
// flow-2b without the user waiting
