// DocBridge — Flow 4: File download
// Bytes come straight from staging, never through the API (ADR-08)
// Dashed self-arrows are local steps, not network calls

title Flow 4: File download

webUI [icon: monitor, label: "Web UI"]
api [icon: docker, label: "DocBridge API"]
docbridgeDB [icon: aws-rds, label: "DocBridge DB"]
staging [icon: aws-simple-storage-service, label: "Staging"]

webUI > api: "request download (job id, file id, token)"
api --> api: "verify token signature locally"
api > docbridgeDB: "job's submitter team ids + staged file key"
docbridgeDB > api: "job + file record"

alt [label: "requester shares no team with submitter", color: red] {
  api > webUI: "403 not visible"
}
else [label: "requester shares a team with submitter"] {
  api --> api: "mint presigned GET (short TTL)"
  api > webUI: "presigned URL"
  webUI > staging: "GET file bytes"
  staging > webUI: "file"
}

// Staged copy stays downloadable for 30 days after job completion —
// the lifecycle rule deletes 32 days after object creation, keyed on a
// completion tag applied when the job finishes (TDD 9.2)
staging --> staging: "lifecycle: delete 32 days after object creation"

// Expected outcome: team transparency over all sent documents
